# Copy to platform/.env. Never commit platform/.env.
# Generate the random value with openssl. See the course 2 lab.

# Public https origin from `cloudflared tunnel --url http://127.0.0.1:5678`, with a trailing slash.
# Example: https://random-name.trycloudflare.com/
# Fill this after n8n is up, then recreate the n8n container. See the course 2 lab.
WEBHOOK_URL=

# Fine-grained GitHub token. Contents and pull requests: read/write. Metadata: read.
GITHUB_TOKEN=

# Same value you paste into the GitHub webhook. openssl rand -hex 20
GITHUB_WEBHOOK_SECRET=

# The local model. `docker compose --profile setup run --rm model-pull` downloads it.
# qwen2.5-coder:3b is about 1.9 GB. Use qwen2.5-coder:1.5b (about 1 GB) on a slow laptop.
OLLAMA_MODEL=qwen2.5-coder:3b
